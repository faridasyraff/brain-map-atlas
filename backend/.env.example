# Copy this file, rename the copy to just ".env", and fill in real values
# there. .env is set up so Git will never track or save it, and it should
# never be shared or uploaded anywhere — it's meant to hold your secrets.

# Needed for the AI chat feature to work (both the OpenAI option in chat, and
# the auto-generated region summaries). Get a key from platform.openai.com.
# You can also set a hard spending limit on that key directly in your OpenAI
# account (Settings -> Billing -> limits) so it can never charge you more
# than you're comfortable with.
OPENAI_API_KEY=

# Signs and encrypts login sessions — required for sign up / sign in to
# work at all. Generate your own random value, don't reuse this comment as
# one. Run this and paste what it prints:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The account with this email is always admin, no matter when they sign
# up. Leave blank and the very first account ever created becomes admin
# instead.
ADMIN_EMAIL=

# Which websites are allowed to talk to this app's backend. Multiple
# addresses can be listed separated by commas. Defaults to only allowing
# your own computer if left blank — update this once the app has a real
# public web address.
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Set to 1 to show the real, detailed error message when something goes
# wrong (useful while you're building/testing). Leave this at 0 once the app
# is live for real visitors — showing them the detailed technical error
# could reveal information you don't want strangers to see.
FLASK_DEBUG=0

# Only needed if you're running your own copy of the CortexMap service
# instead of the one already hosted for you.
# CORTEXMAP_URL=https://capstone.ssdd.dev
