# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies -- unanchored so this catches node_modules/ at any depth
# (backend/node_modules, frontend/node_modules, etc.), not just the root
node_modules/
.pnp
.pnp.js

# testing
/coverage

# production / build output
/build
dist/

# IDE / editor
.idea/
.vscode/*
!.vscode/extensions.json

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

__pycache__/
*.pyc
